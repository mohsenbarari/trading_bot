#!/bin/sh
# Fail-closed launcher for the controller convergence source set.
#
# The only bootstrap currently present lives inside the release being proved.
# Executing it, even from a held descriptor, would execute release-controlled
# bytes before its Git/blob proof.  This launcher must therefore stay
# deliberately unavailable until a separately installed, root-controlled,
# immutable bootstrap is supplied.  In particular, do not open a release
# path, a held plan, or a release-sourced bootstrap from this checkpoint.

set -eu

printf '%s\n' \
    'blocked: controller source-set launcher is unavailable pending a separately installed immutable bootstrap' >&2
exit 69
