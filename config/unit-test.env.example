# Deterministic, non-deployable defaults for local unit-test imports.
#
# These values are placeholders. No service should source this file and the
# unit-test target must not make network connections with them. Tests that need
# a database or Redis provide an isolated fixture explicitly.

DATABASE_URL=postgresql+asyncpg://localhost/trading_bot_unit_test
SYNC_DATABASE_URL=postgresql+asyncpg://localhost/trading_bot_unit_test
POSTGRES_DB=trading_bot_unit_test
POSTGRES_USER=unit_test
POSTGRES_PASSWORD=unit_test_not_used
REDIS_URL=redis://localhost:6379/15
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=unit-test-only-placeholder-never-used
TELEGRAM_PROVIDER_TEST_AUTHORITY=true
