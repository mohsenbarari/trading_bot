# Source code is inert unless its commands are explicitly scheduled.
# Keep the real file outside Git with mode 0600.
COIN_INTELLIGENCE_DATA_ROOT=/var/lib/trading-bot/coin-intelligence
COIN_PRIVATE_EVENT_ROOT=/var/lib/trading-bot/coin-intelligence/private-channel-ingest
COIN_CONVERSATION_DB=/var/lib/trading-bot/coin-intelligence/conversation_events.sqlite3
COIN_CONVERSATION_LABEL_DB=/var/lib/trading-bot/coin-intelligence/conversation_events.reviewed.sqlite3
COIN_MARKET_DB=/var/lib/trading-bot/coin-intelligence/market_prices.sqlite3

# Telegram application credentials. Never commit real values.
COIN_MARKET_TELEGRAM_API_ID=
COIN_MARKET_TELEGRAM_API_HASH=
COIN_MARKET_TELEGRAM_PHONE=

# JSON object keyed by logical stream name. Channel IDs and activation
# boundaries are deployment-private, so the repository contains no values.
# Example shape:
# {"offer":{"id":-1000000000001,"anchor_message_id":10},"trade":{"id":-1000000000002,"anchor_message_id":5},"coin":{"id":-1000000000003,"anchor_message_id":20}}
COIN_PRIVATE_EVENT_CHANNELS_JSON=

# Optional source-vintage boundaries. Keep real private message IDs outside Git.
COIN_PRIVATE_OFFER_STREAM_SPLIT_MESSAGE_ID=
COIN_GOLD_DAY_PAPER_FROM_MESSAGE_ID=
