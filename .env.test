# Settings used when running the test suite.
#
# The suite asserts the defaults declared in core/config.py. A developer or
# deployment .env legitimately turns feature flags on, and reading that file
# during tests makes unrelated suites fail in ways that look like regressions.
#
# This file therefore lists only the settings that have no default and would
# otherwise stop Settings() from constructing. Everything else is deliberately
# absent so it falls back to its code default. Do not add a flag here to make a
# test pass: if a test needs a non-default value, it should set it itself.
#
# Contains no secrets. Values are placeholders; unit tests do not open these
# connections.

DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/trading_bot_test
SYNC_DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/trading_bot_test
POSTGRES_DB=trading_bot_test
POSTGRES_USER=test
POSTGRES_PASSWORD=test
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=test-only-not-a-real-secret
