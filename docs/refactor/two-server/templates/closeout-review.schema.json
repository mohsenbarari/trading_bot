{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer_authority",
    "receipt_type",
    "stage_id",
    "assignment_id",
    "accepted_stage_sha",
    "proposed_patch_sha256",
    "reviewed_at_utc",
    "verdict",
    "scope",
    "findings",
    "decision"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "reviewer_authority": {"type": "string", "const": "CODEX_FINAL_REVIEWER"},
    "receipt_type": {"type": "string", "const": "STAGE_CLOSEOUT_PREACTION"},
    "stage_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$"},
    "assignment_id": {"type": "string", "minLength": 1},
    "accepted_stage_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "proposed_patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewed_at_utc": {"type": "string", "format": "date-time"},
    "verdict": {"enum": ["APPROVE", "CHANGES_REQUIRED", "REJECT", "BLOCKED"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_receipt_valid",
        "changed_paths_closeout_only",
        "state_transition_valid",
        "unauthorized_external_mutation"
      ],
      "properties": {
        "stage_receipt_valid": {"type": "boolean"},
        "changed_paths_closeout_only": {"type": "boolean"},
        "state_transition_valid": {"type": "boolean"},
        "unauthorized_external_mutation": {"type": "string"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "finding", "evidence", "required_action"],
        "properties": {
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
          "finding": {"type": "string"},
          "evidence": {"type": "string"},
          "required_action": {"type": "string"}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_authorized", "residual_risk", "conditions"],
      "properties": {
        "commit_authorized": {"type": "boolean"},
        "residual_risk": {"type": "string"},
        "conditions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
