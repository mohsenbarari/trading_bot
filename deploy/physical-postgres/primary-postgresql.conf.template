# Generated by scripts/render_physical_postgres_deployment.py.
# This file is default-off deployment input, never evidence of a live standby.
# The primary has no PostgreSQL streaming target: FI-to-IR host/database
# control is deliberately prohibited.  The archive handoff is local only.

# The primary is intentionally local-only.  Digest-pinned helper adapters use
# the shared Unix-socket volume; no TCP listener is rendered.
listen_addresses = ''
unix_socket_directories = '/var/run/postgresql'
unix_socket_group = 'postgres'
unix_socket_permissions = 0770
port = 5432
hba_file = '@@PRIMARY_HBA_FILE@@'
ident_file = '@@PRIMARY_IDENT_FILE@@'
data_directory = '/var/lib/postgresql/data'
timezone = 'UTC'
log_timezone = 'UTC'

wal_level = replica
archive_mode = on
archive_timeout = 0
archive_command = 'exec @@WAL_SPOOL_BINARY@@ --config @@PRIMARY_SPOOL_CONFIG@@ --wal-file %f --wal-path %p'

# Exactly one local peer-authenticated base-backup helper may use PostgreSQL's
# replication protocol through the shared Unix socket.  It is not a standby
# streaming channel: no host port, TCP HBA permit, primary_conninfo, or slot is
# rendered.  ``pg_hba.conf`` and ``pg_ident.conf`` in this rendered tree bind
# the sole allowed database role to the image-attested non-root PostgreSQL OS
# identity; a separate preflight must prove actual role attributes.
max_wal_senders = @@LOCAL_BASE_BACKUP_MAX_WAL_SENDERS@@
max_replication_slots = 0
primary_conninfo = ''
primary_slot_name = ''
synchronous_standby_names = ''
synchronous_commit = on

# These custom settings bind this exact rendered role to its immutable
# deployment input.  PostgreSQL does not treat them as a promotion authority;
# the mounted primary-term guard must verify the matching lock document.
goldtrade.physical_release_sha = '@@RELEASE_SHA@@'
goldtrade.physical_base_generation_id = '@@BASE_GENERATION_ID@@'
goldtrade.physical_writer_term_sha256 = '@@WRITER_TERM_SHA256@@'
goldtrade.physical_route_binding_sha256 = '@@ROUTE_BINDING_SHA256@@'
goldtrade.physical_profile = '@@DEPLOYMENT_PROFILE@@'
