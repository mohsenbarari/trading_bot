# Generated by scripts/render_physical_postgres_deployment.py.
# WA-IR is an archive-recovery standby.  It has no primary_conninfo, slot, or
# FI host endpoint; the only intended recovery data route is its local
# Object-Storage pull adapter.  No TCP PostgreSQL listener is rendered: the
# default-off recovery/readback substrate is container-local Unix sockets only.

listen_addresses = ''
unix_socket_directories = '/var/run/postgresql'
unix_socket_group = 'postgres'
unix_socket_permissions = 0770
port = 5432
hba_file = '@@STANDBY_HBA_FILE@@'
data_directory = '/var/lib/postgresql/data'
timezone = 'UTC'
log_timezone = 'UTC'

hot_standby = on
hot_standby_feedback = off
# ``always`` is required even while this node is a standby so a later
# witnessed reverse failback has an ordered local WAL handoff.  The command
# has no no-op fallback: renderer admission requires the reverse spool adapter.
archive_mode = always
archive_command = 'exec @@STANDBY_REVERSE_WAL_SPOOL_BINARY@@ --config @@STANDBY_REVERSE_SPOOL_CONFIG@@ --wal-file %f --wal-path %p'
max_wal_senders = 0
max_replication_slots = 0
primary_conninfo = ''
primary_slot_name = ''
synchronous_standby_names = ''
restore_command = 'exec @@STANDBY_PULL_BINARY@@ --config @@STANDBY_PULL_CONFIG@@ --requested-wal-file %f --destination-path %p'
recovery_target_timeline = 'latest'

# These custom settings bind this exact rendered role to its immutable
# deployment input.  They are metadata, not a promotion or writer authority.
goldtrade.physical_release_sha = '@@RELEASE_SHA@@'
goldtrade.physical_base_generation_id = '@@BASE_GENERATION_ID@@'
goldtrade.physical_writer_term_sha256 = '@@WRITER_TERM_SHA256@@'
goldtrade.physical_route_binding_sha256 = '@@ROUTE_BINDING_SHA256@@'
goldtrade.physical_profile = '@@DEPLOYMENT_PROFILE@@'
