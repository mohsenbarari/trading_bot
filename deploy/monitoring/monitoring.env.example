COMPOSE_PROJECT_NAME=trading_bot_monitoring_dev
MONITORING_APP_PORT=18100
MONITORING_IMAGE_TAG=local
MONITORING_FRONTEND_DIST_DIR=mini_app_dist

ENVIRONMENT=development
SERVER_MODE=foreign
RELEASE_SHA=replace-with-branch-sha
FRONTEND_URL=http://127.0.0.1:18100
PUBLIC_WEBAPP_URL=http://127.0.0.1:18100
EXTRA_CORS_ORIGINS=http://127.0.0.1:18100

DATABASE_URL=postgresql+asyncpg://monitoring_dev:replace-with-random-password@db:5432/trading_bot_monitoring_dev
SYNC_DATABASE_URL=postgresql://monitoring_dev:replace-with-random-password@db:5432/trading_bot_monitoring_dev
POSTGRES_DB=trading_bot_monitoring_dev
POSTGRES_USER=monitoring_dev
POSTGRES_PASSWORD=replace-with-random-password

REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET_KEY=replace-with-random-secret
SYNC_API_KEY=replace-with-random-secret
DEV_API_KEY=replace-with-random-secret
OBSERVABILITY_API_KEY=replace-with-random-secret
OBSERVABILITY_TELEGRAM_USER_HASH_SALT=replace-with-random-secret
AUDIT_TRAIL_PATH=/app/audit_trail/audit.jsonl

BACKGROUND_JOBS_ENABLED=false
WEB_PUSH_ENABLED=false
TELEGRAM_MONITORING_CHANNEL_ENABLED=false
BOT_TOKEN=
CHANNEL_ID=
TELEGRAM_MONITORING_BOT_TOKEN=
TELEGRAM_MONITORING_CHANNEL_ID=

# The bot profile is opt-in and must only use dedicated non-production values.
MONITORING_TELEGRAM_LIVE_ACK=
