[Unit]
Description=GoldTrade WebApp-IR fenced promotion coordinator
Requires=trading-bot-production-writer-lease-guard.service
After=network-online.target docker.service trading-bot-production-writer-lease-guard.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/trading-bot-three-site/releases/2c08da14bfa0ef94d9c788e478d30ddc3f31a3c5
ExecStart=/usr/bin/python3 /srv/trading-bot-three-site/releases/2c08da14bfa0ef94d9c788e478d30ddc3f31a3c5/scripts/run_webapp_ir_promotion_coordinator.py --config /etc/trading-bot-three-site/webapp-ir-promotion-coordinator.json --apply --json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
