[Unit]
Description=GoldTrade WebApp-IR fenced promotion coordinator
Requires=trading-bot-production-writer-lease-guard.service
After=network-online.target docker.service trading-bot-production-writer-lease-guard.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/trading-bot-three-site/webapp-ir-control-release.env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=${WA_IR_CONTROL_RELEASE_ROOT}
ExecStartPre=/usr/bin/python3 ${WA_IR_CONTROL_RELEASE_ROOT}/scripts/manage_webapp_ir_release_provenance.py verify-installed --receipt ${WA_IR_RELEASE_PROVENANCE_RECEIPT}
ExecStart=/usr/bin/python3 ${WA_IR_CONTROL_RELEASE_ROOT}/scripts/run_webapp_ir_promotion_coordinator.py --config /etc/trading-bot-three-site/webapp-ir-promotion-coordinator.json --apply --json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
