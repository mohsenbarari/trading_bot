[Unit]
Description=GoldTrade WebApp-IR fenced promotion coordinator
Requires=trading-bot-production-writer-lease-guard.service
After=network-online.target docker.service trading-bot-production-writer-lease-guard.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/trading-bot-three-site/webapp-ir-control-release.env
WorkingDirectory=/
# This fixed trusted dispatcher verifies the root selected by the environment
# against the create-only receipt before it opens any code in that root.
ExecStart=/usr/bin/python3 -I /srv/trading-bot-three-site/control-dispatcher/manage_webapp_ir_release_provenance.py exec-bound-control --receipt ${WA_IR_RELEASE_PROVENANCE_RECEIPT} --control-release-root ${WA_IR_CONTROL_RELEASE_ROOT} --control-release-sha ${WA_IR_CONTROL_RELEASE_SHA} --target promotion-coordinator --config /etc/trading-bot-three-site/webapp-ir-promotion-coordinator.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
