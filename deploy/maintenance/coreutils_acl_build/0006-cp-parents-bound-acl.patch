+/* Recheck retained parent objects after copying and before restoring selected
+   metadata.  Mutable mode/owner/time values are not object identity.  */
+static bool
+parent_acl_handle_matches (int fd, struct stat const *expected)
+{
+  struct stat actual;
+  if (fd < 0)
+    {
+      errno = EBADF;
+      return false;
+    }
+  if (fstat (fd, &actual) != 0)
+    return false;
+  if (! S_ISDIR (actual.st_mode)
+      || actual.st_dev != expected->st_dev
+      || actual.st_ino != expected->st_ino)
+    {
+      errno = ESTALE;
+      return false;
+    }
+  return true;
+}
