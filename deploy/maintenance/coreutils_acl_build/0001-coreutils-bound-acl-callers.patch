+char *
+gold_acl_proc_self_fd_path(int fd, struct gold_acl_proc_self_fd_buffer *buffer)
+{
+	sprintf(buffer->buffer, "/proc/self/fd/%d", fd);
+	return buffer->buffer;
+}
+
+void
+gold_acl_proc_self_fd_free(char *path, struct gold_acl_proc_self_fd_buffer *buffer)
+{
+	if (path != buffer->buffer)
+		free(path);
+}
+
+char *
+gold_acl_proc_self_fd_realpath(int dirfd, const char *path, int *at_flags,
+		      struct gold_acl_proc_self_fd_buffer *buffer)
+{
+	char *newpath;
+	int ret;
+
+	if (!*path) {
+		*at_flags &= ~AT_SYMLINK_NOFOLLOW;
+		return gold_acl_proc_self_fd_path(dirfd, buffer);
+	}
+	ret = asprintf(&newpath, "/proc/self/fd/%d/%s", dirfd, path);
+	if (ret == -1)
+		return NULL;
+	return newpath;
+}
+
+int
+gold_acl_openat_with_flags(int dirfd, const char *path, int at_flags)
+{
+	int flags = O_PATH | O_CLOEXEC;
+
+	if (at_flags & AT_SYMLINK_NOFOLLOW)
+		flags |= O_NOFOLLOW;
+	return openat(dirfd, path, flags);
+}
+
+/*
+ * gold_acl_getxattrat(), gold_acl_setxattrat(), gold_acl_listxattrat(), and gold_acl_removexattrat() up to at
+ * least kernel version 7.2 fail with EBADF when the dirfd is an O_PATH file
+ * descriptor and the pathname is NULL or empty.
+ */
+int
+gold_acl_need_slow_empty_paths(int dirfd, const char *path)
+{
+	int saved_errno = errno;
+	int open_flags;
+
+	if (errno != EBADF)
+		return 0;
+	if (*path)
+	       return 0;
+	open_flags = fcntl(dirfd, F_GETFL);
+	if (open_flags == -1) {
+		errno = saved_errno;
+		return 0;
+	}
+	if (!(open_flags & O_PATH))
+		return 0;
+	return 1;
+}
