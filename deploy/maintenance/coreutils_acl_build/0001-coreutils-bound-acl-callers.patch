+/* Test whether a file has a nontrivial ACL.  -*- coding: utf-8 -*-
+
+   Copyright (C) 2002-2003, 2005-2025 Free Software Foundation, Inc.
+
+   This program is free software: you can redistribute it and/or modify
+   it under the terms of the GNU General Public License as published by
+   the Free Software Foundation, either version 3 of the License, or
+   (at your option) any later version.
+
+   This program is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+   GNU General Public License for more details.
+
+   You should have received a copy of the GNU General Public License
+   along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+   Written by Paul Eggert, Andreas Grünbacher, and Bruno Haible.  */
+
+/* Private descriptor-only adaptation of Debian coreutils9.7-3 Linux ACL
+   classification for qcopy_acl's EOPNOTSUPP fallback. No path argument exists.
+   Upstream list/get classification, NFSv4 precedence and XDR parser are kept.
+   The caller must retain and identity-admit the object FD and actual st_mode.
+   SOURCE ONLY: compilation and actual filesystem compatibility QA remain open. */
+#include <config.h>
+#include "acl.h"
+#include "nontrivial.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdckdint.h>
+#include <arpa/inet.h>
+#define DECLARATIONS_ONLY
+#include "xattrat_compat.h"
+#undef DECLARATIONS_ONLY
+
+#if !defined __linux__ || !USE_ACL || !USE_XATTR
+# error "Private descriptor-only ACL backport requires Linux ACL and xattr support"
+#endif
+#if !defined O_PATH || !O_PATH || !defined AT_EMPTY_PATH || !AT_EMPTY_PATH
+# error "Private descriptor-only ACL backport requires nonzero O_PATH and AT_EMPTY_PATH"
+#endif
+
+struct gold_acl_info
+{
+  char *buf;
+  ssize_t size;
+  union { int err; char small[152]; } u;
+};
+enum { ACE4_ACCESS_DENIED_ACE_TYPE = 0x00000001,
+       ACE4_IDENTIFIER_GROUP = 0x00000040 };
+static char const gold_nfs4_acl[] = "system.nfs4_acl";
+static char const gold_access_acl[] = "system.posix_acl_access";
+static char const gold_default_acl[] = "system.posix_acl_default";
+
+static bool
+gold_acl_info_may_indicate_xattr (struct gold_acl_info const *ai)
+{
+  return ai->size < 0 && (!acl_errno_valid (ai->u.err)
+                          || ai->u.err == EACCES || ai->u.err == E2BIG);
+}
+
+static bool
+gold_acl_info_has_xattr (struct gold_acl_info const *ai, char const *xattr)
+{
+  if (0 < ai->size)
+    {
+      char const *blim = ai->buf + ai->size;
+      for (char const *b = ai->buf; b < blim; b += strlen (b) + 1)
+        for (char const *a = xattr; *a == *b; a++, b++)
+          if (!*a)
+            return true;
+    }
+  return false;
+}
+
+/* Same allocation-growth and errno policy as upstream get_aclinfo without
+   ACL_GET_SCONTEXT: this private qcopy caller never requests security context. */
+static void
+gold_acl_get_info (int fd, struct gold_acl_info *ai)
+{
+  ai->buf = ai->u.small;
+  ssize_t acl_alloc = sizeof ai->u.small;
+  while (true)
+    {
+      ai->size = gold_acl_listxattrat_compat (fd, "", AT_EMPTY_PATH,
+                                             ai->buf, acl_alloc);
+      if (0 < ai->size)
+        break;
+      ai->u.err = ai->size < 0 ? errno : 0;
+      if (! (ai->size < 0 && ai->u.err == ERANGE && acl_alloc < SSIZE_MAX))
+        break;
+      ssize_t size = gold_acl_listxattrat_compat (fd, "", AT_EMPTY_PATH, NULL, 0);
+      if (size <= 0)
+        {
+          ai->size = size;
+          ai->u.err = size < 0 ? errno : 0;
+          break;
+        }
+      if (ai->buf != ai->u.small)
+        {
+          free (ai->buf);
+          ai->buf = ai->u.small;
+        }
+      if (ckd_add (&acl_alloc, acl_alloc, acl_alloc >> 1))
+        acl_alloc = SSIZE_MAX;
+      if (acl_alloc < size)
+        acl_alloc = size;
+      if (SIZE_MAX < acl_alloc)
+        {
+          ai->u.err = ENOMEM;
+          break;
+        }
+      char *newbuf = malloc (acl_alloc);
+      if (!newbuf)
+        {
+          ai->u.err = errno;
+          break;
+        }
+      ai->buf = newbuf;
+    }
+}
+
+static bool
+gold_acl_has_xattr (char const *xattr, struct gold_acl_info const *ai, int fd)
+{
+  if (gold_acl_info_has_xattr (ai, xattr))
+    return true;
+  else if (gold_acl_info_may_indicate_xattr (ai))
+    {
+      ssize_t ret = gold_acl_getxattrat_compat (fd, "", AT_EMPTY_PATH,
+                                               xattr, NULL, 0);
+      if (0 <= ret || errno == ERANGE || errno == E2BIG)
+        return true;
+    }
+  return false;
+}
+
+static int
+gold_acl_nfs4_nontrivial (uint32_t *xattr, ssize_t nbytes)
+{
+  enum { BYTES_PER_NETWORK_UINT = 4};
+
+  /* Grab the number of aces in the acl.  */
+  nbytes -= BYTES_PER_NETWORK_UINT;
+  if (nbytes < 0)
+    return -1;
+  uint32_t num_aces = ntohl (*xattr++);
+  if (6 < num_aces)
+    return 1;
+  int ace_found = 0;
+
+  for (int ace_n = 0; ace_n < num_aces; ace_n++)
+    {
+      /* Get the acl type and flag.  Skip the mask; it's too risky to
+         test it and it does not seem to be needed.  Get the wholen.  */
+      nbytes -= 4 * BYTES_PER_NETWORK_UINT;
+      if (nbytes < 0)
+        return -1;
+      uint32_t type = ntohl (xattr[0]);
+      uint32_t flag = ntohl (xattr[1]);
+      uint32_t wholen = ntohl (xattr[3]);
+      xattr += 4;
+      int whowords = (wholen / BYTES_PER_NETWORK_UINT
+                      + (wholen % BYTES_PER_NETWORK_UINT != 0));
+      int64_t wholen4 = whowords;
+      wholen4 *= BYTES_PER_NETWORK_UINT;
+
+      /* Trivial ACLs have only ACE4_ACCESS_ALLOWED_ACE_TYPE or
+         ACE4_ACCESS_DENIED_ACE_TYPE.  */
+      if (ACE4_ACCESS_DENIED_ACE_TYPE < type)
+        return 1;
+
+      /* RFC 7530 says FLAG should be 0, but be generous to NetApp and
+         also accept the group flag.  */
+      if (flag & ~ACE4_IDENTIFIER_GROUP)
+        return 1;
+
+      /* Get the who string.  Check NBYTES - WHOLEN4 before storing
+         into NBYTES, to avoid truncation on conversion.  */
+      if (nbytes - wholen4 < 0)
+        return -1;
+      nbytes -= wholen4;
+
+      /* For a trivial ACL, max 6 (typically 3) ACEs, 3 allow, 3 deny.
+         Check that there is at most one ACE of each TYPE and WHO.  */
+      int who2
+        = (wholen == 6 && memcmp (xattr, "OWNER@", 6) == 0 ? 0
+           : wholen == 6 && memcmp (xattr, "GROUP@", 6) == 0 ? 2
+           : wholen == 9 && memcmp (xattr, "EVERYONE@", 9) == 0 ? 4
+           : -1);
+      if (who2 < 0)
+        return 1;
+      int ace_found_bit = 1 << (who2 | type);
+      if (ace_found & ace_found_bit)
+        return 1;
+      ace_found |= ace_found_bit;
+
+      xattr += whowords;
+    }
+
+  return 0;
+}
+
+static int
+gold_acl_classify (int fd, mode_t mode, struct gold_acl_info const *ai,
+                   int initial_errno)
+{
+  if (!gold_acl_info_may_indicate_xattr (ai) && ai->size <= 0)
+    {
+      errno = ai->size < 0 ? ai->u.err : initial_errno;
+      return ai->size;
+    }
+  /* Retain upstream NFSv4 precedence over coexisting POSIX ACLs. */
+  if (!gold_acl_has_xattr (gold_nfs4_acl, ai, fd))
+    return (gold_acl_has_xattr (gold_access_acl, ai, fd)
+            || (S_ISDIR (mode) && gold_acl_has_xattr (gold_default_acl, ai, fd)));
+  uint32_t buf[2 * (6 + 6 + 7)];
+  int ret = gold_acl_getxattrat_compat (fd, "", AT_EMPTY_PATH,
+                                        gold_nfs4_acl, buf, sizeof buf);
+  if (ret < 0)
+    switch (errno)
+      {
+      case ENODATA: return 0;
+      case ERANGE: return 1;
+      default: return -acl_errno_valid (errno);
+      }
+  ret = gold_acl_nfs4_nontrivial (buf, ret);
+  errno = ret < 0 ? EINVAL : initial_errno;
+  return ret;
+}
+
+int
+gold_acl_fd_has_nontrivial (int fd, mode_t mode)
+{
+  if (fd < 0)
+    {
+      errno = EBADF;
+      return -1;
+    }
+  int initial_errno = errno;
+  struct gold_acl_info ai;
+  gold_acl_get_info (fd, &ai);
+  int ret = gold_acl_classify (fd, mode, &ai, initial_errno);
+  int saved_errno = errno;
+  if (ai.buf != ai.u.small)
+    free (ai.buf);
+  errno = saved_errno;
+  return ret;
+}
