+/* Copy extended attributes between files. */
+
+#include "config.h"
+#include <sys/types.h>
+# include <sys/xattr.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include "attr/libattr.h"
+#include <fcntl.h>
