 static mode_t newdir_umask;	/* umask when creating new directories */
 static mode_t current_umask;	/* current umask (which is set to 0 if -p) */
 
+
+/* Return -2 only when creation succeeded but runtime ACL admission did not.
+   Never send that outcome back through the ordinary creation retry loop.
+   The parent selected by tar's normal traversal is held through constructor
+   and O_PATH admission.  This is not an atomic-birth/hardlink attestation. */
+static int
+acl_create_object (char const *file_name, mode_t mode, dev_t device,
+                   int kind, int *object_fd)
+{
+  int parent = chdir_fd;
+  char *leaf = NULL;
+  bool owned = acls_option > 0;
+  *object_fd = -1;
+  if (owned)
+    {
+      parent = xattrs_acl_parent (chdir_fd, file_name, &leaf);
+      if (parent < 0)
+        return -1;
+    }
+  char const *name = owned ? leaf : file_name;
+  int status = (kind == 0 ? mkdirat (parent, name, mode)
+                : kind == 1 ? mknodat (parent, name, mode, device)
+                : mkfifoat (parent, name, mode));
+  if (status == 0 && owned)
+    {
+      struct stat observed;
+      *object_fd = xattrs_acl_open (parent, name, AT_SYMLINK_NOFOLLOW, NULL);
+      bool admitted = (*object_fd >= 0
+                       && fstat (*object_fd, &observed) == 0);
+      if (admitted)
+        admitted = (kind == 0 ? S_ISDIR (observed.st_mode)
+                    : kind == 1
+                    ? ((observed.st_mode & S_IFMT) == (mode & S_IFMT)
+                       && observed.st_rdev == device)
+                    : S_ISFIFO (observed.st_mode));
+      if (!admitted)
+        {
+          int e = *object_fd < 0 ? errno : ESTALE;
+          if (*object_fd >= 0)
+            close (*object_fd);
+          *object_fd = -1;
+          errno = e;
+          open_error (file_name);
+          status = -2;
+        }
+    }
+  int e = errno;
+  free (leaf);
+  if (owned && close (parent) != 0)
+    {
+      e = errno;
+      if (*object_fd >= 0)
+        close (*object_fd);
+      *object_fd = -1;
+      if (status == 0)
+        {
+          close_error (file_name);
+          status = -2;
+        }
+    }
+  errno = e;
+  return status;
+}
