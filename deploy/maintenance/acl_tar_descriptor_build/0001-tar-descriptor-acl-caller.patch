+/* The local Trixie build requires libacl 2.4 descriptor APIs.  These
+   handles select runtime objects, not identities supplied by an archive. */
+int
+xattrs_acl_parent (int parentfd, char const *file_name, char **leaf)
+{
+  char *directory = dir_name (file_name);
+  char *base = base_name (file_name);
+  int fd = openat (parentfd, directory, O_PATH | O_DIRECTORY | O_CLOEXEC);
+  int e = errno;
+  free (directory);
+  if (fd < 0)
+    free (base);
+  else
+    *leaf = base;
+  errno = e;
+  return fd;
+}
+
+static bool
+acl_same_object (struct stat const *a, struct stat const *b)
+{
+  return (a->st_dev == b->st_dev && a->st_ino == b->st_ino
+          && (a->st_mode & S_IFMT) == (b->st_mode & S_IFMT));
+}
+
+int
+xattrs_acl_open (int parentfd, char const *file_name, int atflag,
+                 struct stat const *expected)
+{
+  char *leaf = NULL;
+  int parent = xattrs_acl_parent (parentfd, file_name, &leaf);
+  int fd = -1;
+  struct stat before, after;
+  if (parent < 0)
+    return -1;
+  /* Only ACL lookup strips a trailing slash, which would otherwise make
+     a final link into a directory component and defeat NOFOLLOW.
+     base_len preserves roots; constructors keep their original leaf syntax.
+     Intentional dereferencing still follows the operation's atflag. */
+  leaf[base_len (leaf)] = '\0';
+  if (fstatat (parent, leaf, &before, atflag) == 0)
+    {
+      if (S_ISLNK (before.st_mode)
+          || (expected && !acl_same_object (&before, expected)))
+        errno = ESTALE;
+      else
+        {
+          fd = openat (parent, leaf,
+                       O_PATH | O_CLOEXEC
+                       | (atflag & AT_SYMLINK_NOFOLLOW ? O_NOFOLLOW : 0));
+          if (fd >= 0)
+            {
+              int status = fstat (fd, &after);
+              if (status != 0 || !acl_same_object (&before, &after))
+                {
+                  int e = status != 0 ? errno : ESTALE;
+                  close (fd);
+                  fd = -1;
+                  errno = e;
+                }
+            }
+        }
+    }
+  int e = errno;
+  free (leaf);
+  if (close (parent) != 0 && fd >= 0)
+    {
+      e = errno;
+      close (fd);
+      fd = -1;
+    }
+  errno = e;
+  return fd;
+}
 
