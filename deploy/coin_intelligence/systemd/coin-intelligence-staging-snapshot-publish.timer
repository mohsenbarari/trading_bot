[Unit]
Description=Refresh the local coin-intelligence staging Snapshot every 30 seconds

[Timer]
OnBootSec=20s
# A wall-clock schedule remains observable even though the publisher is a
# short-lived oneshot service (and therefore has no sustained active state).
OnCalendar=*-*-* *:*:00/30
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=coin-intelligence-staging-snapshot-publish.service

[Install]
WantedBy=timers.target
