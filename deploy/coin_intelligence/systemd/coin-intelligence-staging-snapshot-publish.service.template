[Unit]
Description=Publish the local coin-intelligence staging Snapshot
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# The publisher has no network access and only writes the atomic Snapshot and
# its lock under the protected runtime root. It never starts a collector. The
# explicit staging flag publishes a fresh NO_DATA artifact when the market is
# closed; stale artifacts are never refreshed or accepted by the relay.
ExecStart=/usr/bin/docker run --rm --network none --read-only -v @RUNTIME_ROOT@:/runtime:rw @IMAGE@ python scripts/publish_coin_intelligence_snapshot.py publish --runtime-root /runtime --market-store market/market.sqlite3 --snapshot staging/coin-rates.json --publish-staging-no-data-snapshot --environment staging --confirm publish-staging-no-data-snapshot
