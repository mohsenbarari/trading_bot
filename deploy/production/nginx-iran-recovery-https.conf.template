upstream trading_bot_recovery_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name __SERVER_NAME__;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Keep the retired control plane closed consistently on the HTTP
    # listener too; it must not be redirected into a compatibility route.
    location = /api/sync/receive {
        access_log off;
        return 410;
    }

    location ~ ^/api/(sync|sessions/internal|trades/internal|offers/internal|auth/internal|invitations/internal|customers/internal)(/|$) {
        access_log off;
        return 410;
    }

    location ~ ^/register(?:/|$) {
        access_log off;
        add_header Referrer-Policy "no-referrer" always;
        add_header Retry-After "300" always;
        return 503;
    }

    location ^~ /i/ {
        access_log off;
        add_header Referrer-Policy "no-referrer" always;
        add_header Retry-After "300" always;
        return 503;
    }

    location ~ ^/api/invitations/(lookup|validate)/ {
        access_log off;
        add_header Cache-Control "no-store, max-age=0" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Retry-After "300" always;
        return 503;
    }

    location / {
        add_header Retry-After "300" always;
        return 503;
    }
}

server {
    listen 443 ssl http2;
    server_name __SERVER_NAME__;
    client_max_body_size 50M;

    ssl_certificate /etc/letsencrypt/live/__SERVER_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SERVER_NAME__/privkey.pem;

    location = /api/sync/receive {
        # THREE_SITE_LEGACY_INTERNAL_INGRESS_FENCED: FI->IR HTTP replication
        # is retired. The standby consumes encrypted, versioned Object Storage
        # objects under Witness control instead.
        access_log off;
        return 410;
    }

    location ~ ^/api/(sync|sessions/internal|trades/internal|offers/internal|auth/internal|invitations/internal|customers/internal)(/|$) {
        access_log off;
        return 410;
    }

    location ~ ^/register(?:/|$) {
        access_log off;
        add_header Referrer-Policy "no-referrer" always;
        add_header Retry-After "300" always;
        return 503;
    }

    location ^~ /i/ {
        access_log off;
        add_header Referrer-Policy "no-referrer" always;
        add_header Retry-After "300" always;
        return 503;
    }

    location ~ ^/api/invitations/(lookup|validate)/ {
        access_log off;
        add_header Cache-Control "no-store, max-age=0" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Retry-After "300" always;
        return 503;
    }

    location / {
        add_header Retry-After "300" always;
        return 503;
    }
}
