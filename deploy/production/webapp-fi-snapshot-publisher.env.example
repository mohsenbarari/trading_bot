# Root-only WebApp-FI snapshot publisher configuration for production release 2c08.
#
# Copy this outside Git with mode 0600.  It names only local tool/config paths;
# S3 credentials, age recipient, and the source signing key remain in the
# separate root-only transport config.  All data and transport workspace paths
# must be on the dedicated large data volume, never the system disk or /tmp.

RELEASE_SHA=2c08da14bfa0ef94d9c788e478d30ddc3f31a3c5
EXPECTED_ALEMBIC_REVISION=f2c7d8e9a0b1

WA_FI_SNAPSHOT_DATA_ROOT=/srv/trading-bot-standby-data
WA_FI_SNAPSHOT_STATE_ROOT=/srv/trading-bot-standby-data/state
WA_FI_SNAPSHOT_CAPTURE_ENV_FILE=/root/secure-envs/trading-bot/webapp-fi-snapshot-reader.env
WA_FI_SNAPSHOT_TRANSPORT_CONFIG=/root/secure-envs/trading-bot/webapp-fi-snapshot-transport.json

# The publisher uses exactly these local production containers for read-only
# capture.  It never starts, stops, recreates, or changes either container.
WA_FI_SNAPSHOT_DB_CONTAINER=trading_bot_db
WA_FI_SNAPSHOT_APP_CONTAINER=trading_bot_app

# The timer and root-only transport config must use the same 15-30 second
# bound.  One attempt lets the next timer tick create a fresh snapshot instead
# of retrying a potentially stale capture in place.
WA_FI_SNAPSHOT_MAX_AGE_SECONDS=30
WA_FI_SNAPSHOT_CAPTURE_ATTEMPTS=1
