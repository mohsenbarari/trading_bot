# Root-only WA-IR control-release locator.  Install outside Git as 0600.
#
# The application release remains the legacy 2c08 Git identity.  These values
# select only the separately staged control/tooling source that hosts the
# coordinator, lease agent, listener helper, and compose manifest.  They must
# exactly match the create-only receipt written by
# manage_webapp_ir_release_provenance.py install.

WA_IR_CONTROL_RELEASE_SHA=REPLACE_WITH_EXACT_CONTROL_GIT_SHA
WA_IR_CONTROL_RELEASE_ROOT=/srv/trading-bot-three-site/control-releases/REPLACE_WITH_EXACT_CONTROL_GIT_SHA
WA_IR_APPLICATION_RELEASE_SHA=2c08da14bfa0ef94d9c788e478d30ddc3f31a3c5
WA_IR_RELEASE_PROVENANCE_RECEIPT=/var/lib/trading-bot-three-site/release-provenance/REPLACE_WITH_UNIQUE_BUNDLE_ID.json
