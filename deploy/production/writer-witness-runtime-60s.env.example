# Runtime values for the separately deployed Writer Witness 60-second release.
#
# This is a non-secret template. Install the final runtime file outside Git as
# root:root mode 0600, populate the blank credential values there, and do not
# enable/restart the service until the WebApp-FI client timing attestation for
# this exact profile succeeds. The old 180-second WebApp-FI client will be
# rejected once `WRITER_WITNESS_ENFORCE_CONFIGURED_LEASE_DURATION=true` is live.

LOGICAL_AUTHORITY=webapp
PHYSICAL_SITE=witness

WRITER_WITNESS_SERVICE_ENABLED=true
WRITER_WITNESS_DATABASE_URL=
WRITER_WITNESS_PRODUCT_DATABASE_USER=
WRITER_WITNESS_REQUIRE_DISTINCT_DATABASE_IDENTITY=true

WRITER_WITNESS_PRIVATE_KEY_FILE=/run/secrets/webapp_writer_witness_ed25519
WRITER_WITNESS_PUBLIC_KEY=
WRITER_WITNESS_SERVICE_WEBAPP_FI_KEY_ID=
WRITER_WITNESS_SERVICE_WEBAPP_FI_SECRET=
WRITER_WITNESS_SERVICE_WEBAPP_IR_KEY_ID=
WRITER_WITNESS_SERVICE_WEBAPP_IR_SECRET=

# These values are a single compatibility contract. The WebApp-FI writer
# client must use 60/10/15 before this Witness starts enforcing its duration.
WRITER_WITNESS_LEASE_DURATION_SECONDS=60
WRITER_WITNESS_ENFORCE_CONFIGURED_LEASE_DURATION=true
WRITER_WITNESS_RENEW_INTERVAL_SECONDS=10
WRITER_WITNESS_SAFETY_MARGIN_SECONDS=15
WRITER_WITNESS_MAX_CLOCK_SKEW_SECONDS=5
WRITER_WITNESS_AUTH_MAX_AGE_SECONDS=15
WRITER_WITNESS_AUTHORITATIVE_SITE=webapp_fi
