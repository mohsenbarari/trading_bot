{
  "schema": "production-writer-lease-agent-v1",
  "mode": "fenced_fi_writer",
  "site": "webapp_fi",
  "lease_file": "/var/lib/trading-bot-three-site/writer-terms/writer-lease.json",
  "fenced_preflight_config": "/etc/trading-bot-three-site/webapp-fi-fenced-writer-preflight.json",
  "runtime": {
    "compose_file": "/srv/trading-bot-three-site/control-releases/REPLACE_WITH_EXACT_CONTROL_GIT_SHA/deploy/production/docker-compose.webapp-fi-writer-2c08.yml",
    "env_file": "/root/secure-envs/trading-bot/wa-fi-fenced-writer-runtime.env",
    "selection_env_file": null,
    "services": ["app", "bot"]
  },
  "witness": {
    "url": "https://witness.example.invalid",
    "key_id": "REPLACE_WITH_WA_FI_KEY_ID",
    "secret_file": "/root/secure-envs/trading-bot/wa-fi-witness-client.secret",
    "public_key_file": "/root/secure-envs/trading-bot/witness-ed25519-public.key",
    "ca_bundle": "/root/secure-envs/trading-bot/witness-ca.pem",
    "timeout_seconds": 3,
    "lease_duration_seconds": 60,
    "safety_margin_seconds": 15,
    "renew_interval_seconds": 10
  }
}
