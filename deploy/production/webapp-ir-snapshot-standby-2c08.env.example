# Root-only WA-IR snapshot-standby configuration for production release 2c08.
#
# Copy this outside Git.  The generic Object Storage transport consumes its own
# root-only config; do not place credentials, age identities, TLS keys, or
# presigned URLs in this file or in the repository.

COMPOSE_PROJECT_NAME=trading_bot_wa_ir_standby
RELEASE_SHA=2c08da14bfa0ef94d9c788e478d30ddc3f31a3c5
EXPECTED_ALEMBIC_REVISION=f2c7d8e9a0b1

# Exact images must arrive via an immutable, age-encrypted, private/versioned
# Object Storage bundle and be loaded locally before either compose command.
# Do not substitute a later three-site staging image with a bind-mounted tree.
WA_IR_APP_IMAGE=trading_bot_base:rollback-2c08da14-9ed63dd3e446
WA_IR_POSTGRES_IMAGE=postgres:15-alpine
WA_IR_REDIS_IMAGE=redis:7-alpine

# This root must be on the dedicated large data volume, not the system disk or
# /tmp.  The transport workspace and restore evidence live below it.
WA_IR_STANDBY_DATA_ROOT=/srv/trading-bot-three-site-staging-data/wa-ir-standby
WA_IR_SNAPSHOT_WORK_ROOT=/srv/trading-bot-three-site-staging-data/wa-ir-standby/work
WA_IR_SNAPSHOT_STATE_ROOT=/srv/trading-bot-three-site-staging-data/wa-ir-standby/state
WA_IR_SNAPSHOT_RECEIPT_ROOT=/srv/trading-bot-three-site-staging-data/wa-ir-standby/receipts
# Leave unset until the separate Writer Witness controller has been installed
# with active-pointer binding checks.  When enabled, the restore wrapper writes
# only this nonsecret, root-only, atomic latest receipt after a verified audit
# and active candidate pointer; it never starts or routes the application.
# WA_IR_WITNESS_RESTORE_RECEIPT_PATH=/var/lib/trading-bot-three-site/snapshots/latest-restore-receipt.json
# Match the root-only transport config.  Both consumer and final active-pointer
# gate use the actual source_db_snapshot_started_at clock, never capture finish.
WA_IR_SNAPSHOT_MAX_AGE_SECONDS=30
# These are deliberate post-operation reserves.  Set both from a measured
# capacity plan before installation; the restore refuses to create a new
# candidate if its DB reserve, extracted archives, and this margin do not fit.
WA_IR_SNAPSHOT_MIN_FREE_BYTES=8589934592
WA_IR_SNAPSHOT_DATABASE_RESTORE_RESERVE_BYTES=4294967296

# The immutable legacy *application* bundle is delivered through Object
# Storage and unpacked under this exact release path.  It is mounted read-only
# only on promotion.  Do not point this at the separate control/tooling root.
WA_IR_APPLICATION_RELEASE_ROOT=/srv/trading-bot-three-site/releases/2c08da14bfa0ef94d9c788e478d30ddc3f31a3c5
# The separate root-only WA_IR_PROMOTION_RUNTIME_ENV_FILE passed to the writer
# agent must repeat this exact variable and RELEASE_SHA=2c08... because Compose
# receives that promotion env, not this standby env, during activation.

# The restore wrapper derives generation-qualified names and writes a temporary
# compose env file.  Do not manually reuse these placeholders for another run.
WA_IR_SNAPSHOT_DB_CONTAINER=trading_bot_wa_ir_snapshot_db_replace_generation
WA_IR_CANDIDATE_DB_VOLUME=trading_bot_wa_ir_pg_replace_generation
WA_IR_CANDIDATE_UPLOADS_VOLUME=trading_bot_wa_ir_uploads_replace_generation
WA_IR_RUNTIME_NETWORK_NAME=trading_bot_wa_ir_runtime
# The promotion controller atomically overrides this with a generation-bound
# value from active-snapshot.json.  This placeholder must never be reused.
WA_IR_REDIS_VOLUME_NAME=trading_bot_wa_ir_redis_unselected
# Promotion must use the audit volume restored from the same verified snapshot.
# Leave this placeholder untouched during standby refresh; the promotion proof
# controller derives the generation-qualified value from active-snapshot.json.
WA_IR_CANDIDATE_AUDIT_VOLUME=trading_bot_wa_ir_audit_replace_generation
WA_IR_APP_LOCAL_PORT=18000

# This env contains only POSTGRES_* and Docker log tuning.  It stays root-only
# and is used by the restore wrapper and both compose manifests.
WA_IR_STANDBY_DATABASE_ENV_FILE=/root/secure-envs/trading-bot/wa-ir-standby-db.env

# This is the role-scoped application env received age-encrypted through Object
# Storage.  It must target the local `db` and `redis` service names and preserve
# the source JWT/session secrets where continuity requires them.  It must never
# contain a copied WA-FI TLS private key.
WA_IR_PROMOTION_RUNTIME_ENV_FILE=/root/secure-envs/trading-bot/wa-ir-promotion.env

# Generic snapshot transport config.  It carries only Arvan endpoint/bucket,
# private/versioned prefix, age recipient/identity paths, and scoped S3 creds.
WA_IR_SNAPSHOT_TRANSPORT_CONFIG=/root/secure-envs/trading-bot/wa-ir-snapshot-transport.json

# Enable together with the Writer Witness agent.  The refresh wrapper checks
# it both before Object Storage consume and immediately before restore; while
# this verified local term is live it cannot replace the promoted candidate.
# WA_IR_WRITER_LEASE_FILE=/var/lib/trading-bot-three-site/writer-lease.json

DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5
