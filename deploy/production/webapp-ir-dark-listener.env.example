# Copy outside Git with owner root and mode 0600.  All source material must
# already have been issued locally by Certbot on WA-IR.  This helper never
# invokes Certbot, DNS, Arvan, Object Storage, or a remote host.
WA_IR_DARK_LISTENER_SERVER_NAME=coin.gold-trade.ir
WA_IR_DARK_LISTENER_CERTBOT_ROOT=/etc/letsencrypt
WA_IR_DARK_LISTENER_CERTBOT_LINEAGE=/etc/letsencrypt/live/coin.gold-trade.ir

# The private destination is deliberately separate from Certbot's lineage.
# The local promoted-listener gate consumes this same root later.
WA_IR_DARK_LISTENER_TLS_ROOT=/etc/trading-bot-three-site/wa-ir/tls
WA_IR_DARK_LISTENER_CERTIFICATE_PATH=/etc/trading-bot-three-site/wa-ir/tls/fullchain.pem
WA_IR_DARK_LISTENER_CERTIFICATE_KEY_PATH=/etc/trading-bot-three-site/wa-ir/tls/privkey.pem

# The installer may create these exact local paths only when they are absent.
# If the site already exists, it must exactly match this helper's rendered dark
# listener and be root-owned mode 0644; a legacy or promoted site is rejected.
# An existing enabled symlink must already target this exact site.
WA_IR_DARK_LISTENER_SITE_PATH=/etc/nginx/sites-available/trading-bot
WA_IR_DARK_LISTENER_ENABLED_PATH=/etc/nginx/sites-enabled/trading-bot
WA_IR_DARK_LISTENER_RECEIPT_PATH=/var/lib/trading-bot-three-site/wa-ir/dark-listener.json
