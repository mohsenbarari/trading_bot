# Root-only WebApp-FI fenced-writer runtime configuration for release 2c08.
#
# Copy outside Git and replace every REPLACE_* value with an existing local
# Docker resource.  This compose project never creates the listed network or
# volumes, never pulls/builds images, and only exposes its app on loopback.
# Keep database/Redis credentials and application secrets only in the root-only
# installed copy, not in this example.  The systemd guard does not load this
# file: its non-secret paths are rendered from the fenced preflight config.

RELEASE_SHA=2c08da14bfa0ef94d9c788e478d30ddc3f31a3c5
WA_FI_WRITER_APP_IMAGE=REPLACE_WITH_PRELOADED_2C08_APP_IMAGE
WA_FI_WRITER_BOT_IMAGE=REPLACE_WITH_PRELOADED_2C08_BOT_IMAGE
WA_FI_WRITER_RUNTIME_ENV_FILE=/root/secure-envs/trading-bot/wa-fi-fenced-writer-runtime.env
WA_FI_WRITER_APPLICATION_RELEASE_ROOT=/srv/trading-bot-three-site/releases/2c08da14bfa0ef94d9c788e478d30ddc3f31a3c5
WA_FI_WRITER_TERM_PARENT_DIRECTORY=/var/lib/trading-bot-three-site/writer-terms
WA_FI_WRITER_RUNTIME_NETWORK_NAME=REPLACE_WITH_PREEXISTING_RUNTIME_NETWORK
WA_FI_WRITER_UPLOADS_VOLUME=REPLACE_WITH_PREEXISTING_UPLOADS_VOLUME
WA_FI_WRITER_AUDIT_VOLUME=REPLACE_WITH_PREEXISTING_AUDIT_VOLUME
# Keep the existing WebApp-FI Nginx upstream on 8000 unchanged. This fenced
# listener is deliberately dark until a separately authorized routing gate
# verifies the guard is active and switches the proxy upstream.
WA_FI_WRITER_APP_LOCAL_PORT=18001
APPLICATION_WRITER_TERM_SAFETY_MARGIN_SECONDS=15
APPLICATION_WRITER_TERM_MAX_LEASE_DURATION_SECONDS=60

# A future immutable term-fenced application release must consume this switch
# before database initialization.  Historical 2c08 does not; this template is
# not approval to start that image.
DATABASE_SCHEMA_BOOTSTRAP_ENABLED=false
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5
