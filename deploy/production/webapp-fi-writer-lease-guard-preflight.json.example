{
  "schema": "fenced-fi-writer-preflight-v2",
  "control_release_root": "/srv/trading-bot-three-site/control-releases/REPLACE_WITH_EXACT_CONTROL_GIT_SHA",
  "application_release_root": "/srv/trading-bot-three-site/releases/REPLACE_WITH_NEW_TERM_FENCED_APPLICATION_GIT_SHA",
  "agent_config": "/etc/trading-bot-three-site/production-writer-lease-agent.webapp-fi-fenced-2c08.json",
  "preflight_config": "/etc/trading-bot-three-site/webapp-fi-fenced-writer-preflight.json",
  "unit_file": "/etc/systemd/system/trading-bot-production-writer-fi-fenced-lease-guard.service",
  "lease_file": "/var/lib/trading-bot-three-site/writer-terms/writer-lease.json",
  "runtime_env_file": "/root/secure-envs/trading-bot/wa-fi-fenced-writer-runtime.env",
  "runtime_env_sha256": "REPLACE_WITH_64_HEX_REVIEWED_RUNTIME_ENV_SHA256",
  "term_parent_directory": "/var/lib/trading-bot-three-site/writer-terms",
  "app_local_port": 18001,
  "release_identity": {
    "descriptor": "/etc/trading-bot-three-site/webapp-fi-fenced-release-identity.json",
    "authority_public_key": "/etc/trading-bot-three-site/webapp-fi-fenced-release-identity-authority.pub",
    "expected_identity_sha256": "REPLACE_WITH_64_HEX_SIGNED_IDENTITY_SHA256"
  },
  "term_fenced_application_evidence": "/etc/trading-bot-three-site/webapp-fi-term-fenced-application-evidence.json",
  "runtime_resources": {
    "network_name": "REPLACE_WITH_REVIEWED_PREEXISTING_RUNTIME_NETWORK",
    "uploads_volume": "REPLACE_WITH_REVIEWED_PREEXISTING_UPLOADS_VOLUME",
    "audit_volume": "REPLACE_WITH_REVIEWED_PREEXISTING_AUDIT_VOLUME"
  },
  "runtime": {
    "compose_file": "/srv/trading-bot-three-site/control-releases/REPLACE_WITH_EXACT_CONTROL_GIT_SHA/deploy/production/docker-compose.webapp-fi-writer-2c08.yml",
    "compose_project": "trading_bot_wa_fi_writer_2c08",
    "services": [
      {
        "name": "app",
        "container_name": "trading_bot_wa_fi_writer_2c08_app",
        "image_ref": "REPLACE_WITH_REVIEWED_LOCAL_APP_IMAGE_TAG",
        "image_repo_digest": "REPLACE_WITH_REVIEWED_APP_REPOSITORY@sha256:REPLACE_WITH_64_HEX_APP_REPOSITORY_DIGEST",
        "image_id": "sha256:REPLACE_WITH_64_HEX_APP_IMAGE_ID"
      },
      {
        "name": "bot",
        "container_name": "trading_bot_wa_fi_writer_2c08_bot",
        "image_ref": "REPLACE_WITH_REVIEWED_LOCAL_BOT_IMAGE_TAG",
        "image_repo_digest": "REPLACE_WITH_REVIEWED_BOT_REPOSITORY@sha256:REPLACE_WITH_64_HEX_BOT_REPOSITORY_DIGEST",
        "image_id": "sha256:REPLACE_WITH_64_HEX_BOT_IMAGE_ID"
      }
    ]
  }
}
