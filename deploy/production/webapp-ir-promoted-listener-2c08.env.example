# Root-only WA-IR promoted-listener activation configuration.
#
# Copy outside Git with owner root and mode 0600.  The TLS directory, its
# certificate, and its key are created locally on WA-IR by the constrained
# DNS-01 process.  Do not place a TLS key, token, or any material from another
# host in this file.

WA_IR_LISTENER_SERVER_NAME=coin.gold-trade.ir
# Static assets come from the legacy application release, never from the
# separately staged control/tooling root that runs this helper.
WA_IR_LISTENER_APPLICATION_RELEASE_ROOT=/srv/trading-bot-three-site/releases/2c08da14bfa0ef94d9c788e478d30ddc3f31a3c5
# This create-only root-only receipt binds the exact Git root above.  The
# listener refuses any same-named alternate directory or stale receipt.
WA_IR_LISTENER_RELEASE_PROVENANCE_RECEIPT=/var/lib/trading-bot-three-site/release-provenance/REPLACE_WITH_UNIQUE_BUNDLE_ID.json
WA_IR_LISTENER_TLS_ROOT=/etc/trading-bot-three-site/wa-ir/tls
WA_IR_LISTENER_CERTIFICATE_PATH=/etc/trading-bot-three-site/wa-ir/tls/fullchain.pem
WA_IR_LISTENER_CERTIFICATE_KEY_PATH=/etc/trading-bot-three-site/wa-ir/tls/privkey.pem

# This must already be the enabled dark-listener target.  The helper refuses
# to create or repoint an Nginx site symlink, and replaces this one target only
# after validation.  On failed validation/reload it restores the prior bytes.
WA_IR_LISTENER_SITE_PATH=/etc/nginx/sites-available/trading-bot
WA_IR_LISTENER_ENABLED_PATH=/etc/nginx/sites-enabled/trading-bot

# Create this directory first as root:root mode 0700.  The helper writes this
# nonsecret receipt only after `nginx -t` and `nginx -s reload` both succeed.
WA_IR_LISTENER_RECEIPT_PATH=/var/lib/trading-bot-three-site/listener-receipts/webapp-ir-promoted.json
