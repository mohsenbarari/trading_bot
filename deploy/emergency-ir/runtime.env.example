# Generated on WA-IR only. Do not store a populated copy in Git.
COMPOSE_PROJECT_NAME=trading-bot-emergency-ir
EMERGENCY_RUNTIME_ENV_FILE=/etc/trading-bot-emergency/standalone/runtime.env
EMERGENCY_APP_PORT=18000
EMERGENCY_TRADING_SETTINGS_FILE=/srv/trading-bot-emergency/current/trading_settings.json
SOURCE_RELEASE_SHA=REPLACE_WITH_40_HEX_PRODUCTION_SHA
EMERGENCY_PATCH_SHA=REPLACE_WITH_40_HEX_EMERGENCY_PATCH_SHA
RELEASE_SHA=REPLACE_WITH_40_HEX_EMERGENCY_PATCH_SHA
EMERGENCY_APP_IMAGE=trading_bot_emergency_ir_app:REPLACE_WITH_40_HEX_EMERGENCY_PATCH_SHA
EMERGENCY_POSTGRES_IMAGE=trading_bot_emergency_ir_postgres:REPLACE_WITH_ATTESTED_TAG
EMERGENCY_REDIS_IMAGE=trading_bot_emergency_ir_redis:REPLACE_WITH_ATTESTED_TAG

# The default is Telegram WebApp initData validation only.  Do not add an
# SMS.ir key here.  The SMS profile is rendered only by the explicit
# --enable-sms-otp command and uses a separate attested relay image.
EMERGENCY_AUTH_PROFILE=telegram-only
EMERGENCY_SMS_OTP_ENABLED=false

# The renderer creates the following root-only values locally on WA-IR:
# POSTGRES_PASSWORD, DATABASE_URL, SYNC_DATABASE_URL, JWT_SECRET_KEY,
# DEV_API_KEY, and observability salts. A separately encrypted
# WEBAPP_INITDATA_BOT_TOKEN is streamed to the renderer only for local Telegram
# WebApp initData HMAC validation; no bot service is installed or started. It
# never copies SYNC_API_KEY, peer URLs, web-push credentials, or witness/DR
# credentials.  The optional SMS.ir API key is accepted only as a separate
# JSON stdin value by the explicit SMS renderer invocation.
