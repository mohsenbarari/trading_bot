# This file contains no credentials. Runtime secret values are mounted as files.
MARKET_PIPELINE_PROJECT_NAME=market-private-pipeline
MARKET_PIPELINE_IMAGE=registry.example.invalid/trading-bot/market-pipeline@sha256:replace-me
MARKET_PIPELINE_RELEASE_SHA=replace-with-git-sha
MARKET_PIPELINE_MODE=disabled

# Host-specific persistent roots. Staging and production must use different paths.
MARKET_WEB_DATA_ROOT=/srv/trading-bot/market-data
MARKET_BOT_DATA_ROOT=/srv/trading-bot/production-data/coin-intelligence/private-pipeline

# Exact provider-private bind address. Never use 0.0.0.0 or a public address.
MARKET_PRIVATE_BIND_IP=10.0.0.2
MARKET_WEB_SNAPSHOT_RECEIVER_PORT=9443
MARKET_BOT_FACT_RECEIVER_PORT=9443

# Root-only files outside Git. Values are never put in this env file.
MARKET_POSTGRES_PASSWORD_FILE=/srv/trading-bot/secure/agent-access/market-data/postgres-password
MARKET_CAPTURE_ACCOUNT1_CONFIG_FILE=/srv/trading-bot/secure/agent-access/market-data/account1-config.json
MARKET_CAPTURE_ACCOUNT2_CONFIG_FILE=/srv/trading-bot/secure/agent-access/market-data/account2-config.json
MARKET_CAPTURE_ACCOUNT2_HMAC_FILE=/srv/trading-bot/secure/agent-access/market-data/account2-peer-hmac
MARKET_TRANSPORT_CA_FILE=/srv/trading-bot/secure/agent-access/market-data/transport-ca.pem
MARKET_WEB_TRANSPORT_CERT_FILE=/srv/trading-bot/secure/agent-access/market-data/web-transport-cert.pem
MARKET_WEB_TRANSPORT_KEY_FILE=/srv/trading-bot/secure/agent-access/market-data/web-transport-key.pem
MARKET_BOT_TRANSPORT_CERT_FILE=/srv/trading-bot/secure/agent-access/market-data/bot-transport-cert.pem
MARKET_BOT_TRANSPORT_KEY_FILE=/srv/trading-bot/secure/agent-access/market-data/bot-transport-key.pem
MARKET_HMAC_ACTIVE_FILE=/srv/trading-bot/secure/agent-access/market-data/hmac-active
MARKET_HMAC_PREVIOUS_FILE=/srv/trading-bot/secure/agent-access/market-data/hmac-previous

MARKET_POSTGRES_USER=market_data
MARKET_POSTGRES_DB=market_archive
MARKET_POSTGRES_MAX_CONNECTIONS=100
MARKET_HEALTH_MAX_AGE_SECONDS=30
MARKET_PROCESSOR_INTERVAL_SECONDS=1
MARKET_LOG_MAX_SIZE=10m
MARKET_LOG_MAX_FILE=5
