# Copy outside Git into a root-owned 0700 directory and chmod 0600.
# This file contains topology and secret paths only. The release controller adds
# image/SHA/mode/feed authority values and rejects them if present here.
MARKET_WEB_DATA_ROOT=/srv/trading-bot/market-data-production
MARKET_PRIVATE_BIND_IP=10.240.1.20
MARKET_WEB_PRIVATE_IP=10.240.1.20
MARKET_BOT_PRIVATE_IP=10.240.1.10
MARKET_WEB_SNAPSHOT_RECEIVER_PORT=9443
MARKET_BOT_FACT_RECEIVER_PORT=9443

MARKET_POSTGRES_PASSWORD_FILE=/srv/trading-bot/secure/market-data/postgres-password
MARKET_CAPTURE_ACCOUNT1_CONFIG_FILE=/srv/trading-bot/secure/market-data/account1-config.json
MARKET_CAPTURE_ACCOUNT2_CONFIG_FILE=/srv/trading-bot/secure/market-data/account2-config.json
MARKET_CAPTURE_ACCOUNT2_HMAC_FILE=/srv/trading-bot/secure/market-data/account2-peer-hmac
MARKET_RESEARCH_ENCRYPTION_KEY_FILE=/srv/trading-bot/secure/market-data/research-archive.key
MARKET_RESEARCH_ENCRYPTION_KEY_ID=market-research:v1
MARKET_RESEARCH_ARCHIVE_ENABLED=1
MARKET_TRANSPORT_CA_FILE=/srv/trading-bot/secure/market-data/transport-ca.pem
MARKET_WEB_TRANSPORT_CERT_FILE=/srv/trading-bot/secure/market-data/web-transport-cert.pem
MARKET_WEB_TRANSPORT_KEY_FILE=/srv/trading-bot/secure/market-data/web-transport-key.pem
MARKET_HMAC_ACTIVE_FILE=/srv/trading-bot/secure/market-data/hmac-active
MARKET_HMAC_PREVIOUS_FILE=/srv/trading-bot/secure/market-data/hmac-previous

MARKET_POSTGRES_USER=market_data
MARKET_POSTGRES_DB=market_archive
MARKET_POSTGRES_MAX_CONNECTIONS=100
MARKET_HEALTH_MAX_AGE_SECONDS=30
MARKET_PROCESSOR_INTERVAL_SECONDS=1
MARKET_EXTERNAL_POLL_SECONDS=10
MARKET_FACT_SENDER_INSTANCE_ID=web-market-sync-1
MARKET_PIPELINE_SNAPSHOT_STALE_AFTER_SECONDS=30
MARKET_LOG_MAX_SIZE=10m
MARKET_LOG_MAX_FILE=5
