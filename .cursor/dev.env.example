# Dev-only environment for the Cloud Agent / local native (non-docker) setup.
# Copied to ./.env by .cursor/install.sh. Contains NO real secrets.

# --- Database (local PostgreSQL on 127.0.0.1:5432) ---
DATABASE_URL=postgresql+asyncpg://trading_bot:trading_bot_dev@127.0.0.1:5432/trading_bot
SYNC_DATABASE_URL=postgresql+psycopg2://trading_bot:trading_bot_dev@127.0.0.1:5432/trading_bot
POSTGRES_DB=trading_bot
POSTGRES_USER=trading_bot
POSTGRES_PASSWORD=trading_bot_dev

# --- Redis (local on 127.0.0.1:6379) ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- App / server ---
# server_mode=iran serves the user-facing WebApp API surface (the `foreign`
# role intentionally blocks public routes and defers them to the Iran peer).
ENVIRONMENT=staging
SERVER_MODE=iran
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
LOG_FORMAT=console

# Dev-only: log OTP codes to the app log (and store in Redis) instead of
# sending them via SMS/Telegram, and enable the local /api/auth/dev-login
# shortcut. Never enable these outside local/dev.
STAGING_LOG_OTP_CODES=true

# --- Secrets (development placeholders only) ---
JWT_SECRET_KEY=dev-only-jwt-secret-change-me
TELEGRAM_PROVIDER_TEST_AUTHORITY=false

# --- Telegram bot (blank; the aiogram bot process is not run in this env) ---
BOT_TOKEN=
BOT_USERNAME=
